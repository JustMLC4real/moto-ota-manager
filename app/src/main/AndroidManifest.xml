<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.motorola.ccc.ota" />
        <package android:name="com.topjohnwu.magisk" />
        <intent><action android:name="android.settings.SYSTEM_UPDATE_SETTINGS" /></intent>
    </queries>
    <application android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true"
        android:usesCleartextTraffic="false" android:label="Moto OTA Manager"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:icon="@drawable/ic_moto_ota">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
